# Datasets and machine-local builds/envs (data/DataManager.py is code and stays tracked)
CoDeepNEAT/data/Datasets/
external/

# Logs and scratch
/logs/
/tmp/
*.log
nohup.out

# Python
**/__pycache__/
*.pyc
.compile_cache/
.ipynb_checkpoints/

# Large regenerable artefacts
CoDeepNEAT/runs/**/*_layers.pt

# keep CoDeepNEAT's own run logs (search / full-train records)
!CoDeepNEAT/runs/**/*.log

# Model weights (*.pt, *.model) and generation pickles are tracked with Git LFS (.gitattributes)

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.env

# Architecture graphs are regenerated by vnm/plot_architectures.py; kept out of the repo
/figures/architectures/

# LaTeX build artefacts (report.pdf is kept)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
